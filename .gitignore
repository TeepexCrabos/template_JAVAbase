# ==========================================================
# .gitignore - Template Java base (IntelliJ IDEA, JDK 21, sans Maven/Gradle)
# ==========================================================

# ---------- Sortie de compilation ----------
out/
bin/
target/
build/
*.class

# ---------- IntelliJ IDEA ----------
# Fichiers propres au poste / à l'utilisateur : jamais dans le dépôt
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/tasks.xml
.idea/shelf/
.idea/dictionaries/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.ids
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml
.idea/dbnavigator.xml
.idea/caches/
.idea/libraries/
.idea/aws.xml
.idea/copilot/
.idea/sonarlint/
*.iws
*.ipr

# Volontairement CONSERVÉS dans le dépôt (ne pas ignorer) :
#   *.iml, .idea/modules.xml, .idea/misc.xml, .idea/.gitignore
# -> ils mémorisent "src = Sources Root", le module et le JDK,
#    donc le projet se lance directement après un clone.

# ---------- Archives et rendus ----------
*.zip
*.rar
*.7z
*.jar
*.war

# ---------- Journaux et fichiers temporaires ----------
*.log
hs_err_pid*
replay_pid*
*.tmp
*.bak
*.swp
*~

# ---------- Windows ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- macOS / Linux (si clone ailleurs) ----------
.DS_Store
.directory

# ---------- Autres éditeurs ----------
.vscode/
.settings/
.classpath
.project
*.code-workspace

# ---------- Secrets éventuels ----------
.env
*.local